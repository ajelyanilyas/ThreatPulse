# Copy to backend/.env for local development (all values shown are defaults).

# Database. SQLite locally; a Postgres URL in production.
DATABASE_URL=sqlite:///./threatpulse.db

# Ingestion scheduling.
INGEST_INTERVAL_MINUTES=60
INGEST_ON_STARTUP=true
SCHEDULER_ENABLED=true
MAX_ROWS_PER_FEED=5000

# Free abuse.ch Auth-Key — required for the ThreatFox feed (URLhaus & Feodo
# work anonymously). Register at https://auth.abuse.ch
ABUSECH_AUTH_KEY=

# Optional on-demand enrichment providers. Without these, enrichment falls
# back to local feed matches + heuristics.
ABUSEIPDB_API_KEY=
OTX_API_KEY=
